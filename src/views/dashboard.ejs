<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header>
        <h1>Welcome to Your Dashboard</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/links">My Links</a></li>
                <li><a href="/analytics">Analytics</a></li>
                <li><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section>
            <h2>Your Shortened Links</h2>
            <table>
                <thead>
                    <tr>
                        <th>Original URL</th>
                        <th>Shortened URL</th>
                        <th>Expiration Time</th>
                        <th>Analytics</th>
                    </tr>
                </thead>
                <tbody>
                    <% links.forEach(link => { %>
                        <tr>
                            <td><%= link.originalUrl %></td>
                            <td><a href="<%= link.shortenedUrl %>"><%= link.shortenedUrl %></a></td>
                            <td><%= link.expirationTime %></td>
                            <td><a href="/analytics/<%= link.id %>">View Analytics</a></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </section>
    </main>
    <footer>
        <p>&copy; <%= new Date().getFullYear() %> TempLink. All rights reserved.</p>
    </footer>
</body>
</html>